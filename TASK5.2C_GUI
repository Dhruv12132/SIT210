import tkinter as tk
import RPi.GPIO as GPIO

# Use GPIO pin numbers
GPIO.setmode(GPIO.BCM)

# GPIO pins
LIVING = 18
BATHROOM = 27
CLOSET = 22

# Set pins as outputs
GPIO.setup(LIVING, GPIO.OUT)
GPIO.setup(BATHROOM, GPIO.OUT)
GPIO.setup(CLOSET, GPIO.OUT)

# Set up PWM for the Living Room LED
living_pwm = GPIO.PWM(LIVING, 1000)
living_pwm.start(0)

# Turn other LEDs off at the start
GPIO.output(BATHROOM, GPIO.LOW)
GPIO.output(CLOSET, GPIO.LOW)


# This function changes the selected room light
def change_light():

    selected_room = room.get()

    # Turn off bathroom and closet
    GPIO.output(BATHROOM, GPIO.LOW)
    GPIO.output(CLOSET, GPIO.LOW)

    # Control the Living Room using PWM
    if selected_room == "Living Room":
        living_pwm.ChangeDutyCycle(brightness.get())

    else:
        living_pwm.ChangeDutyCycle(0)

    # Turn on the selected room
    if selected_room == "Bathroom":
        GPIO.output(BATHROOM, GPIO.HIGH)

    elif selected_room == "Closet":
        GPIO.output(CLOSET, GPIO.HIGH)


# This function changes the Living Room brightness
def change_brightness(value):

    if room.get() == "Living Room":
        living_pwm.ChangeDutyCycle(float(value))


# This function closes the program safely
def exit_program():

    living_pwm.ChangeDutyCycle(0)

    GPIO.output(BATHROOM, GPIO.LOW)
    GPIO.output(CLOSET, GPIO.LOW)

    living_pwm.stop()
    GPIO.cleanup()

    window.destroy()


# Create the GUI window
window = tk.Tk()
window.title("Room Light Control")
window.geometry("350x400")


# Heading
title = tk.Label(
    window,
    text="Select a Room",
    font=("Arial", 18)
)

title.pack(pady=20)


# Store the selected room
room = tk.StringVar()


# Living Room button
tk.Radiobutton(
    window,
    text="Living Room",
    variable=room,
    value="Living Room",
    command=change_light
).pack()


# Bathroom button
tk.Radiobutton(
    window,
    text="Bathroom",
    variable=room,
    value="Bathroom",
    command=change_light
).pack()


# Closet button
tk.Radiobutton(
    window,
    text="Closet",
    variable=room,
    value="Closet",
    command=change_light
).pack()


# Store the brightness value
brightness = tk.IntVar(value=50)


# Brightness text
tk.Label(
    window,
    text="Living Room Brightness",
    font=("Arial", 12)
).pack(pady=(25, 5))


# Brightness slider
tk.Scale(
    window,
    from_=0,
    to=100,
    orient="horizontal",
    variable=brightness,
    command=change_brightness,
    length=250
).pack()


# Exit button
tk.Button(
    window,
    text="Exit",
    command=exit_program
).pack(pady=25)


# Start the GUI
window.mainloop()
