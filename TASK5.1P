import tkinter as tk
import RPi.GPIO as GPIO

GPIO.setmode(GPIO.BCM)

GPIO.setup(17, GPIO.OUT)
GPIO.setup(27, GPIO.OUT)
GPIO.setup(22, GPIO.OUT)

GPIO.output(17, GPIO.LOW)
GPIO.output(27, GPIO.LOW)
GPIO.output(22, GPIO.LOW)


def select_room():
    GPIO.output(17, GPIO.LOW)
    GPIO.output(27, GPIO.LOW)
    GPIO.output(22, GPIO.LOW)

    if room.get() == "Living Room":
        GPIO.output(17, GPIO.HIGH)

    elif room.get() == "Bathroom":
        GPIO.output(27, GPIO.HIGH)

    elif room.get() == "Closet":
        GPIO.output(22, GPIO.HIGH)


def exit_program():
    GPIO.output(17, GPIO.LOW)
    GPIO.output(27, GPIO.LOW)
    GPIO.output(22, GPIO.LOW)
    GPIO.cleanup()
    window.destroy()


window = tk.Tk()
window.title("House Lights")
window.geometry("350x300")

label = tk.Label(window, text="Select a Room", font=("Arial", 18))
label.pack(pady=20)

room = tk.StringVar()

living = tk.Radiobutton(
    window,
    text="Living Room",
    variable=room,
    value="Living Room",
    command=select_room
)
living.pack()

bathroom = tk.Radiobutton(
    window,
    text="Bathroom",
    variable=room,
    value="Bathroom",
    command=select_room
)
bathroom.pack()

closet = tk.Radiobutton(
    window,
    text="Closet",
    variable=room,
    value="Closet",
    command=select_room
)
closet.pack()

exit_button = tk.Button(
    window,
    text="Exit",
    command=exit_program
)
exit_button.pack(pady=20)

window.mainloop()
